{
  "name": "finder",
  "productName": "Finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@supabase/supabase-js": "^2.112.4",
    "@turf/turf": "^7.4.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.crafter.finder",
    "productName": "Finder",
    "icon": "imgs_finder/icon_256.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "imgs_finder/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "imgs_finder/icon_256.png"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.4",
    "wait-on": "^9.1.0"
  }
}
